# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Load in shells with:   set -a; source .env; set +a
# Load in Python with python-dotenv, or os.getenv after sourcing.

# NCBI Entrez E-utilities (for reference-DB downloads, e.g. matK from nuccore).
# A free API key lifts the rate limit from 3 to 10 requests/sec.
# Get one at: https://www.ncbi.nlm.nih.gov/account/  → Settings → API Key Management
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=sequence-annotation-db-build
